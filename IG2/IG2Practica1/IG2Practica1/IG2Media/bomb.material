material bomb/body{
    technique{
        pass{
            ambient 0.05 0.05 0.05
            diffuse 0.08 0.08 0.08
            specular 0.4 0.4 0.4 30
        }
    }
}

material bomb/fuse{
    technique{
        pass{
            ambient 0.35 0.2 0.1
            diffuse 0.55 0.35 0.15
        }
    }
}

material bomb/flame{
    technique{
        pass{
            lighting off
            scene_blend add
            depth_write off
            diffuse vertexcolour

            texture_unit{
                texture smoke.png
                tex_address_mode clamp
            }
        }
    }
}

material bomb/smoke{
    technique{
        pass{
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit{
                texture smoke.png
                tex_address_mode clamp
            }
        }
    }
}
