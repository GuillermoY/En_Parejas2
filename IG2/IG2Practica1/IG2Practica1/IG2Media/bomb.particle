// Fuego de la mecha. Sin "duration" -> emite indefinidamente (se controla con setEmitting)
particle_system bomb/fuseFire{
    billboard_type point
    particle_width 14
    particle_height 14
    quota 100
    material bomb/flame

    emitter Point{
        direction 0 1 0
        angle 25
        emission_rate 60
        time_to_live 0.5
        velocity_min 20
        velocity_max 40
    }

    // Amarillo -> naranja -> humo a lo largo de la vida de la particula
    affector ColourImage{
        image smokecolors.png
    }

    affector Scaler{
        rate -10
    }
}

// Humo de la explosion. Tambien de duracion indefinida: la clase Bomb lo para
particle_system bomb/explosionSmoke{
    billboard_type point
    particle_width 60
    particle_height 60
    quota 400
    material bomb/smoke

    emitter Point{
        direction 0 1 0
        angle 90
        emission_rate 200
        time_to_live 1.2
        velocity_min 80
        velocity_max 160
        colour 0.6 0.6 0.6 0.8
    }

    affector ColourFader{
        red -0.2
        green -0.2
        blue -0.2
        alpha -0.6
    }

    affector Scaler{
        rate 60
    }
}
